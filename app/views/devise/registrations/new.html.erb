<div class="auth-wrap">
  <div class="auth-card">
    <h1>Create an account</h1>
    <p class="auth-sub">Takes about ten seconds to get set up.</p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="auth-field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="auth-field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <%= f.select :role, [["I'm looking for a home (customer)", "customer"], ["I want to list properties (vendor)", "vendor"]] %>
      <%= f.submit "Sign up", class: "auth-submit" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "Already have an account? Log in", new_session_path(resource_name) %>
    </div>
  </div>
</div>