<div class="auth-wrap">
  <div class="auth-card">
    <h1>Create an account</h1>
    <p class="auth-sub">Takes about ten seconds to get set up.</p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="auth-field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="auth-field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="role-picker">
        <span class="role-picker-label">I am a…</span>
        <div class="role-options">
          <label class="role-option">
            <%= f.radio_button :role, "customer" %>
            <span class="role-card">
              <span class="role-icon">🏠</span>
              <strong>Customer</strong>
              <small>I want to rent or buy a home</small>
            </span>
          </label>

          <label class="role-option">
            <%= f.radio_button :role, "vendor" %>
            <span class="role-card">
              <span class="role-icon">🔑</span>
              <strong>Vendor</strong>
              <small>I want to list properties</small>
            </span>
          </label>
        </div>
      </div>

      <%= f.submit "Sign up", class: "auth-submit" %>
    <% end %>

    <%= render "devise/shared/google_button" %>

    <div class="auth-links">
      <%= link_to "Already have an account? Log in", new_session_path(resource_name) %>
    </div>
  </div>
</div>