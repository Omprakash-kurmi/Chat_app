<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#1b1f3b">
  <h2 style="margin:0 0 8px">A new home matches your saved search</h2>
  <p style="color:#6b7280;margin:0 0 18px"><%= @search.name %></p>

  <div style="border:1px solid #e3e5ef;border-radius:14px;padding:18px">
    <p style="margin:0;font-size:20px;font-weight:700;color:#5b21f0">
      <%= number_to_currency(@property.price, unit: "₹", precision: 0, delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) %><%= "/month" if @property.rent? %>
    </p>
    <p style="margin:6px 0;font-size:17px;font-weight:600"><%= @property.title %></p>
    <p style="margin:0;color:#6b7280">
      📍 <%= [@property.locality, @property.city].compact_blank.join(", ") %>
      <% if @property.bedrooms %> · 🛏 <%= @property.bedrooms %> bed<% end %>
      <% if @property.area_sqft %> · 📐 <%= number_with_delimiter(@property.area_sqft) %> sq ft<% end %>
    </p>
  </div>

  <p style="margin:22px 0">
    <%= link_to "View this home", property_url(@property),
          style: "display:inline-block;padding:12px 22px;border-radius:12px;background:#5b21f0;color:#fff;text-decoration:none;font-weight:700" %>
  </p>
  <p style="color:#9ca3af;font-size:12px">
    You get this because alerts are on for this search.
    <%= link_to "Manage saved searches", saved_searches_url, style: "color:#6b7280" %>
  </p>
</div>
