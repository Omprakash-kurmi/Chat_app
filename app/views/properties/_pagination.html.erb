<% if collection.total_pages > 1 %>
  <%
    current = collection.current_page
    last    = collection.total_pages
    pages   = ([1, last] + ((current - 2)..(current + 2)).to_a).select { |n| n.between?(1, last) }.uniq.sort
    link    = ->(n) { url_for(request.query_parameters.merge(listing_type: @listing_type, page: n)) }
    from    = collection.offset_value + 1
    to      = [collection.offset_value + collection.limit_value, collection.total_count].min
    previous = nil
  %>

  <style>
    .sh .pg { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 44px 0 0; }
    .sh .pg .pg-link { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;
      min-width: 44px; height: 44px; padding: 0 14px; border: 1.5px solid #e3e5ef; border-radius: 14px; background: #fff;
      color: #1b1f3b; font-size: 15px; font-weight: 600; line-height: 1; text-decoration: none; transition: all .15s; }
    .sh .pg a.pg-link:hover { border-color: #5b21f0; color: #5b21f0; background: #f0eaff; transform: translateY(-1px); }
    .sh .pg .pg-link.is-current { border-color: transparent; background: linear-gradient(135deg, #7c4dff, #5b21f0);
      color: #fff; box-shadow: 0 8px 18px rgba(91,33,240,.35); }
    .sh .pg .pg-link.is-disabled { opacity: .45; cursor: not-allowed; background: #f6f6fa; }
    .sh .pg .pg-step { padding: 0 18px; }
    .sh .pg .pg-gap { min-width: 24px; text-align: center; color: #6b7280; font-weight: 700; }
    .sh .pg-info { margin: 14px 0 0; text-align: center; color: #6b7280; font-size: 14px; }
    @media (max-width: 640px) {
      .sh .pg .pg-link { min-width: 40px; height: 40px; padding: 0 10px; }
      .sh .pg .pg-step { padding: 0 14px; }
    }
  </style>

  <nav class="pg" aria-label="Pagination">
    <% if current > 1 %>
      <%= link_to "‹ Prev", link.call(current - 1), class: "pg-link pg-step", rel: "prev" %>
    <% else %>
      <span class="pg-link pg-step is-disabled">‹ Prev</span>
    <% end %>

    <% pages.each do |n| %>
      <% if previous && n - previous > 1 %><span class="pg-gap">…</span><% end %>
      <% if n == current %>
        <span class="pg-link is-current" aria-current="page"><%= n %></span>
      <% else %>
        <%= link_to n.to_s, link.call(n), class: "pg-link" %>
      <% end %>
      <% previous = n %>
    <% end %>

    <% if current < last %>
      <%= link_to "Next ›", link.call(current + 1), class: "pg-link pg-step", rel: "next" %>
    <% else %>
      <span class="pg-link pg-step is-disabled">Next ›</span>
    <% end %>
  </nav>
  <p class="pg-info">Showing <%= from %>–<%= to %> of <%= collection.total_count %> homes</p>
<% end %>