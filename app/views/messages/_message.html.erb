<div class="message" data-user-id="<%= message.user_id %>">
  <div class="bubble">
    <span class="sender">
      <% if message.user.avatar.attached? %>
        <%= image_tag rails_storage_proxy_url(message.user.avatar.variant(resize_to_fill: [20, 20])), class: "sender-avatar" %>
      <% else %>
        <span class="sender-avatar sender-initial"><%= message.user.display_name.to_s.first.to_s.upcase %></span>
      <% end %>
      <%= message.user.display_name %>
    </span>

    <% if message.image.attached? %>
      <%= image_tag rails_storage_proxy_url(message.image.variant(resize_to_limit: [320, 320])), class: "message-image", alt: "Photo" %>
    <% end %>

    <% if message.content.present? %>
      <p class="content"><%= message.content %></p>
    <% end %>

    <span class="time"><%= message.created_at.strftime("%H:%M") %></span>
  </div>
</div>