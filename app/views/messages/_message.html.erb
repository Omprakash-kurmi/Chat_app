<div class="message" data-user-id="<%= message.user_id %>">
  <div class="bubble">
    <span class="sender">
      <%= user_avatar(message.user, size: 20, extra_class: "sender-avatar") %>
      <%= display_name(message.user) %>
    </span>

    <% if message.image.attached? %>
      <% if message.image.variable? %>
        <%= image_tag rails_storage_proxy_url(message.image.variant(resize_to_limit: [320, 320])), class: "message-image", alt: "Photo" %>
      <% else %>
        <%= image_tag rails_storage_proxy_url(message.image), class: "message-image", alt: "Photo" %>
      <% end %>
    <% end %>

    <% if message.content.present? %>
      <p class="content"><%= message.content %></p>
    <% end %>

    <span class="time"><%= message.created_at.strftime("%H:%M") %></span>
  </div>
</div>