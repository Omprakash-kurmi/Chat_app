<h1>New Room</h1>

<%= form_with model: @room do |f| %>
  <% if @room.errors.any? %>
    <div class="error">
      <ul>
        <% @room.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <%= f.submit "Create Room" %>
<% end %>