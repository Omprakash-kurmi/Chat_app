<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<% end %>

<%
  avatar_palette = ["#3462f9", "#e8543e", "#1d9a6c", "#c27803", "#7c4fe0"]
%>

<div class="rooms-wrap">

  <div class="hero-band">
    <span class="live-pill"><span class="live-dot"></span> Live</span>
    <h1>Welcome back, <%= current_user.email.split("@").first %></h1>
    <p>Every room here updates in real time — jump into one and the conversation is already moving.</p>

    <div class="hero-stats">
      <div class="hero-stat">
        <span class="num"><%= @rooms.size %></span>
        <span class="label"><%= pluralize(@rooms.size, "room") %></span>
      </div>
      <div class="hero-stat">
        <span class="num"><%= @messages_today %></span>
        <span class="label">messages today</span>
      </div>
      <div class="hero-stat">
        <span class="num"><%= @message_counts.values.sum %></span>
        <span class="label">messages all time</span>
      </div>
    </div>
  </div>

  <div class="rooms-top">
    <h2>Your chat rooms</h2>
    <% if current_user.admin? %>
      <%= link_to new_room_path, class: "new-room-btn" do %>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v12M2 8h12"/></svg>
        New room
      <% end %>
    <% end %>
  </div>

  <% if @rooms.any? %>
    <ul class="room-grid">
      <% @rooms.each do |room| %>
        <% last = @last_messages[room.id] %>
        <li>
          <%= link_to room_path(room), class: "room-card" do %>
            <span class="room-avatar" style="background: <%= avatar_palette[room.id % avatar_palette.length] %>">
              <%= room.name.first.upcase %>
            </span>
            <span class="room-info">
              <span class="room-info-top">
                <span class="room-name"><%= room.name %></span>
                <% if last %>
                  <span class="room-time"><%= last.created_at.strftime("%b %-d") %></span>
                <% end %>
              </span>
              <p class="room-preview">
                <%= last ? truncate(last.content, length: 48) : "No messages yet" %>
              </p>
              <span class="room-count"><%= pluralize(@message_counts[room.id] || 0, "message") %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state">
      <h2>No rooms yet</h2>
      <% if current_user.admin? %>
        <p>Create the first one to get conversations started.</p>
        <%= link_to "New room", new_room_path, class: "new-room-btn" %>
      <% else %>
        <p>An admin needs to create a room before you can start chatting.</p>
      <% end %>
    </div>
  <% end %>

</div>
