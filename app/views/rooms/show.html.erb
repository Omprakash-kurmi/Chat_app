<%# add to app/views/rooms/show.html.erb, or move to a stylesheet %>
<style>
  #chat-container {
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    height: 80vh;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    font-family: sans-serif;
  }

  #messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background: #e5ddd5;
    display: flex;
    flex-direction: column;
  }

  .message {
    display: flex;
    margin-bottom: 6px;
  }

  .message.sent {
    justify-content: flex-end;
  }

  .message.received {
    justify-content: flex-start;
  }

  .bubble {
    max-width: 70%;
    padding: 6px 10px;
    border-radius: 8px;
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
    position: relative;
  }

  .message.sent .bubble {
    background: #dcf8c6;
    border-top-right-radius: 0;
  }

  .message.received .bubble {
    background: #fff;
    border-top-left-radius: 0;
  }

  .sender {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #075e54;
    margin-bottom: 2px;
  }

  .message.sent .sender {
    display: none; /* don't show your own name on sent bubbles */
  }

  .content {
    margin: 0;
    font-size: 14px;
    word-wrap: break-word;
  }

  .time {
    display: block;
    font-size: 10px;
    color: #999;
    text-align: right;
    margin-top: 2px;
  }

  #message-form {
    display: flex;
    padding: 8px;
    background: #f0f0f0;
  }

  #message-input {
    flex: 1;
    padding: 10px 14px;
    border: none;
    border-radius: 20px;
    outline: none;
  }

  #message-form button {
    background: #075e54;
    color: white;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    margin-left: 8px;
    font-size: 16px;
    cursor: pointer;
  }
</style>
<%# app/views/rooms/show.html.erb %>
<h1><center>Well come to the live chat </h1>
<h2><center><%= @room.name %></h2>

<div id="chat-container" data-current-user-id="<%= current_user.id %>">
  <div id="messages" data-room-id="<%= @room.id %>">
    <%= render @messages %>
  </div>

  <form id="message-form">
    <input type="text" id="message-input" placeholder="Type a message..." autocomplete="off">
    <button type="submit">➤</button>
  </form>
</div>