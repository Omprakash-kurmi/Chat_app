<div class="profile-wrap">
  <div class="profile-header">
    <% if @user.avatar.attached? %>
      <%= image_tag rails_storage_proxy_url(@user.avatar.variant(resize_to_fill: [72, 72])), class: "profile-avatar" %>
    <% else %>
      <span class="profile-avatar-fallback"><%= @user.display_name.first.upcase %></span>
    <% end %>
    <div>
      <h1><%= @user.display_name %></h1>
      <p><%= @user.email %></p>
    </div>
  </div>

  <% if @user.bio.present? %>
    <p class="profile-bio"><%= @user.bio %></p>
  <% end %>

  <%= link_to "Edit profile", edit_profile_path, class: "btn" %>
</div>