<%
  src    = @user.avatar.attached? ? url_for(@user.avatar) : @user.avatar_url.presence
  google = @user.provider.present?
%>
<% content_for :head do %>
  <%= stylesheet_link_tag "pf_profile", "data-turbo-track": "reload" %>
<% end %>

<div class="pf">
  <h1>Your profile</h1>
  <p class="pf-sub">This is how you appear to owners and other members.</p>

  <div class="pf-card">
    <div class="pf-top">
      <span class="pf-av" <%= tag.attributes(style: "background-image:url('#{src}')") if src %>><%= @user.display_name.to_s[0].to_s.upcase unless src %></span>
      <div class="pf-who">
        <strong><%= @user.display_name %></strong>
        <span class="pf-mail"><%= @user.email %></span>
        <div class="pf-tags">
          <span class="pf-tag"><%= @user.role.to_s.humanize %></span>
          <% if google %><span class="pf-tag g">Google</span><% end %>
        </div>
      </div>
      <%= link_to "Edit profile", edit_profile_path, class: "pf-edit" %>
    </div>

    <div class="pf-stats">
      <% if @user.vendor? %>
        <div class="pf-stat"><b><%= @user.properties.count %></b><span>Listings</span></div>
        <div class="pf-stat"><b><%= @user.inquiries.count %></b><span>Inquiries</span></div>
      <% else %>
        <div class="pf-stat"><b><%= @user.favorites.count %></b><span>Favorites</span></div>
        <div class="pf-stat"><b><%= @user.saved_searches.count %></b><span>Saved searches</span></div>
        <div class="pf-stat"><b><%= @user.inquiries.count %></b><span>Inquiries</span></div>
      <% end %>
    </div>

    <dl class="pf-info">
      <div><dt>Name</dt><dd><%= @user.name.presence || @user.display_name %></dd></div>
      <div><dt>Email</dt><dd><%= @user.email %></dd></div>
      <div><dt>Account type</dt><dd><%= @user.role.to_s.humanize %></dd></div>
      <div><dt>Signed up with</dt><dd><%= google ? "Google" : "Email and password" %></dd></div>
      <div><dt>Member since</dt><dd><%= @user.created_at.strftime("%B %Y") %></dd></div>
      <div><dt>Bio</dt><% if @user.bio.present? %><dd><%= simple_format(h(@user.bio)) %></dd><% else %><dd class="none">No bio yet. Add one so owners know who you are.</dd><% end %></div>
    </dl>
  </div>

  <div class="pf-card pf-out">
    <div><strong>Sign out</strong><small>You will need to log in again on this device.</small></div>
    <%= button_to "Sign out", destroy_user_session_path, method: :delete %>
  </div>
</div>