<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<% end %>

<div class="home-wrap">

  <section class="hero">
    <div class="hero-inner">
      <div>
        <h1>Say it once. Everyone in the room sees it the moment you do.</h1>
        <p>Chat_App keeps conversations in dedicated rooms and delivers every message instantly — no refresh, no delay.</p>
        <div class="hero-actions">
          <% if user_signed_in? %>
            <%= link_to "Go to your rooms", rooms_path, class: "btn btn-primary" %>
          <% else %>
            <%= link_to "Create an account", new_user_registration_path, class: "btn btn-primary" %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-ghost" %>
          <% end %>
        </div>
      </div>

      <div class="chat-mock" aria-hidden="true">
        <div class="chat-mock-header">
          <span class="dot"></span> Weekend Plans — 3 online
        </div>
        <div class="bubble-row received">
          <div class="bubble">Are we still on for Saturday?<time>10:02</time></div>
        </div>
        <div class="bubble-row sent">
          <div class="bubble">Yep, I'll bring the tent.<time>10:03</time></div>
        </div>
        <div class="bubble-row received">
          <div class="bubble">Perfect, see you both there.<time>10:03</time></div>
        </div>
        <div class="bubble-row sent">
          <div class="bubble">🎒<time>10:04</time></div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="features-inner">
      <div>
        <h2>Built around real conversations</h2>
        <p>Nothing about this app tries to be everything. It does one job — getting a message from one screen to another without you noticing the trip.</p>
      </div>

      <div class="point-list">
        <div class="point">
          <h3>Delivered as you type it</h3>
          <p>Messages travel over a live connection, so the person on the other end sees your words while you're still in the room.</p>
        </div>
        <div class="point">
          <h3>Organized into rooms</h3>
          <p>Every conversation has its own space, so a chat about the weekend never gets tangled up with one about work.</p>
        </div>
        <div class="point">
          <h3>Nothing lost on refresh</h3>
          <p>Reload the page, come back tomorrow — the last fifty messages are always right where you left them.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <h2>Pick a room, start talking.</h2>
    <p>It takes about ten seconds to get set up.</p>
    <% if user_signed_in? %>
      <%= link_to "Go to your rooms", rooms_path, class: "btn btn-primary" %>
    <% else %>
      <%= link_to "Create an account", new_user_registration_path, class: "btn btn-primary" %>
    <% end %>
  </section>

</div>