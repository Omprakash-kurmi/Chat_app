<% content_for :head do %>
  <%= stylesheet_link_tag "hm_home", "data-turbo-track": "reload" %>
<% end %>

<div class="hmx">

  <!-- HERO -->
  <section class="hmx-hero">
    <span class="hmx-blob hmx-blob--a"></span>
    <span class="hmx-blob hmx-blob--b"></span>

    <div class="hmx-hero-text">
      <span class="hmx-pill"><i></i> Live chat · Rooms · Properties</span>
      <h1>Say it once. Everyone in the room sees it <em>the moment you do.</em></h1>
      <p>Chat_App keeps conversations in dedicated rooms and delivers every message instantly — no refresh, no delay.</p>

      <div class="hmx-cta">
        <% if user_signed_in? %>
          <%= link_to "Go to your rooms →", rooms_path, class: "hmx-btn hmx-btn--white" %>
          <%= link_to "My inquiries", inquiries_path, class: "hmx-btn hmx-btn--ghost" %>
        <% else %>
          <%= link_to "Get started free", new_user_registration_path, class: "hmx-btn hmx-btn--white" %>
          <%= link_to "Sign in", new_user_session_path, class: "hmx-btn hmx-btn--ghost" %>
        <% end %>
      </div>

      <ul class="hmx-trust">
        <li>⚡ Instant delivery</li>
        <li>📷 Photo sharing</li>
        <li>🎥 Voice &amp; video calls</li>
      </ul>
    </div>

    <div class="hmx-mock">
      <div class="hmx-mock-card">
        <div class="hmx-mock-head">
          <span class="hmx-mock-av">W</span>
          <div><b>Weekend Plans</b><small><i></i> 3 online</small></div>
        </div>
        <div class="hmx-mock-body">
          <div class="hmx-b hmx-b--them" style="--d:.3s">Are we still on for Saturday?<small>10:02</small></div>
          <div class="hmx-b hmx-b--me" style="--d:1.1s">Yep, I'll bring the tent. ⛺<small>10:03</small></div>
          <div class="hmx-b hmx-b--them" style="--d:1.9s">Perfect, see you both there.<small>10:03</small></div>
          <div class="hmx-b hmx-b--me hmx-b--emoji" style="--d:2.6s">🧡<small>10:04</small></div>
          <div class="hmx-typing" style="--d:3.2s"><span></span><span></span><span></span></div>
        </div>
        <div class="hmx-mock-bar"><span>Type a message...</span><b>➤</b></div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="hmx-section">
    <div class="hmx-head">
      <span class="hmx-eyebrow">Why Chat_App</span>
      <h2>Built around real conversations</h2>
      <p>Nothing about this app tries to be everything. It does one job — getting a message from one screen to another without you noticing the trip.</p>
    </div>

    <div class="hmx-grid">
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--violet">⚡</span>
        <h3>Delivered as you type it</h3>
        <p>Messages travel over a live connection, so the person on the other end sees your words while you're still in the room.</p>
      </article>
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--pink">💬</span>
        <h3>Organized into rooms</h3>
        <p>Every conversation has its own space, so a chat about the weekend never gets tangled up with one about work.</p>
      </article>
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--teal">💾</span>
        <h3>Nothing lost on refresh</h3>
        <p>Your history is saved. Come back tomorrow, on any device, and the whole conversation is waiting for you.</p>
      </article>
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--amber">📷</span>
        <h3>Photos &amp; emoji</h3>
        <p>Share pictures that appear instantly for everyone, and add a little life with the built-in emoji picker.</p>
      </article>
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--blue">🎥</span>
        <h3>Voice &amp; video calls</h3>
        <p>Switch from typing to talking in one tap. Calls start right inside the chat, with no extra app.</p>
      </article>
      <article class="hmx-card">
        <span class="hmx-ico hmx-ico--green">📅</span>
        <h3>Events &amp; RSVPs</h3>
        <p>Plan get-togethers on a shared calendar and see who is going, maybe, or can't make it.</p>
      </article>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="hmx-section hmx-steps-wrap">
    <div class="hmx-head hmx-head--center">
      <span class="hmx-eyebrow">How it works</span>
      <h2>Up and chatting in three steps</h2>
    </div>
    <ol class="hmx-steps">
      <li><span>1</span><h3>Join a room</h3><p>Pick a room from the list or