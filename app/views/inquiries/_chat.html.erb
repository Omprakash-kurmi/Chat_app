<% me    = current_user %>
<% peer  = owner_view ? inquiry.user : inquiry.property.user %>
<% role  = owner_view ? "Customer" : "Owner" %>
<% phone = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>'.html_safe %>
<% cam   = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="12" rx="3"/><path d="m22 8-5 3.5v1L22 16z"/></svg>'.html_safe %>
<% mic   = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/></svg>'.html_safe %>

<section class="icx" id="icx-chat" data-inquiry-id="<%= inquiry.id %>" data-user-id="<%= me.id %>" data-peer-name="<%= peer.display_name %>">
  <header class="icx-head">
    <span class="icx-av"><%= peer.display_name.to_s[0].to_s.upcase %></span>
    <div class="icx-who"><b><%= peer.display_name %></b><small><%= role %></small></div>
    <% if inquiry.chat_open? %>
      <div class="icx-callbtns">
        <button type="button" class="icx-cbtn" data-call="audio" title="Voice call" aria-label="Voice call"><%= phone %></button>
        <button type="button" class="icx-cbtn" data-call="video" title="Video call" aria-label="Video call"><%= cam %></button>
      </div>
    <% end %>
  </header>

  <%= turbo_stream_from inquiry, :messages %>
  <div id="inquiry_<%= inquiry.id %>_messages" class="icx-msgs">
    <%= render partial: "inquiry_messages/message", collection: messages, as: :message %>
  </div>

  <% if inquiry.chat_open? %>
    <div class="icx-prev"></div>
    <div class="icx-emoji"><div class="icx-etabs"></div><div class="icx-egrid"></div></div>
    <%= render "inquiry_messages/form", inquiry: inquiry %>
    <div class="icx-toast" role="status"></div>

    <div class="icx-call-ui">
      <video class="icx-remote" autoplay playsinline></video>
      <video class="icx-local" autoplay playsinline muted></video>
      <div class="icx-call-avatar"></div>
      <h3 class="icx-call-name"></h3>
      <p class="icx-call-status"></p>
      <div class="icx-ctrls">
        <button type="button" class="icx-cc mute" title="Mute" aria-label="Mute"><%= mic %></button>
        <button type="button" class="icx-cc cam" title="Camera" aria-label="Camera"><%= cam %></button>
        <button type="button" class="icx-cc accept" title="Accept" aria-label="Accept"><%= phone %></button>
        <button type="button" class="icx-cc hang" title="End" aria-label="End call" style="transform:rotate(135deg)"><%= phone %></button>
      </div>
    </div>
  <% else %>
    <p class="icx-closed">This conversation is closed (<%= inquiry.status_label.downcase %>).</p>
  <% end %>
</section>