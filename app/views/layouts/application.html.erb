<!DOCTYPE html>
<html>
  <head>
    <title>Chat_App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
    <%= stylesheet_link_tag "search", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "navbar","favorites","site","rooms","profile","inquiries","events","chat_room","auth", "footer", "properties", "home", "landing", "data-turbo-track": "reload" %>
  </head>
  <body>
    <%= render "devise/shared/navbar" %>

    <% if notice %>
      <div class="flash flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash flash-alert"><%= alert %></div>
    <% end %>

    <main class="page-shell">
      <%= yield %>
    </main>
    <%= render "devise/shared/footer" %>
  </body>
</html>